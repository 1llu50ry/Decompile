{
  "name": "decompile",
  "version": "6.0.1",
  "bin": {
    "decompile": "bin/decompile.mjs"
  },
  "description": "One MCP for reverse engineering across binaries, applications, and runtime behavior. 6,000+ skills, 170+ agents, 160+ subagents, 190+ plugins, 3,000+ prompts, full-text grep, native TS parsers for PE/ELF/Mach-O/DEX/WASM/ASAR/GGUF/BEAM/Go/.NET, decompiler and debugger bridges, instrumentation, memory analysis, structured findings with evidence and unknowns, and a one-shot CLI (setup / analyze / inspect / capabilities / doctor / guidance).",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test": "tsc && node --test tests/*.test.mjs",
    "prepublishOnly": "npm run build",
    "pack:dry": "npm pack --dry-run",
    "prepack": "node scripts/prepack-check.mjs"
  },
  "files": [
    "dist/",
    "bin/",
    "signatures/",
    "plugins-side/",
    "examples/",
    "deploy/",
    "docs/",
    "scripts/",
    "db/skills.db",
    "README.md",
    "LICENSE",
    "install.sh",
    "install.ps1",
    "npm-shrinkwrap.json"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "decompile",
    "decompiler",
    "disassembly",
    "disassembler",
    "reverse-engineering",
