# ===================================================================
# decompile — .gitignore
# ===================================================================

# -------- Node / JS ----------------------------------------------------
node_modules/
dist/
build/
out/
coverage/
.next/
.turbo/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
*.js.map
*.d.ts.map
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/
.pnp.*

# -------- Rust ---------------------------------------------------------
# The release binary is shipped via GitHub Releases, not git.
/core/target/
**/*.rs.bk
# per-user Cargo overrides — never commit these
.cargo-ok

# -------- Secrets / env ------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
# Scratch credential files (used once by maintenance scripts and then
# deleted). Keep these patterns loose on purpose.
.gh-token
.secret*
*.token
*.secret
.credentials
# Setup writes timestamped backups next to agent configs.
*.bak-*
*.bak

# -------- OS cruft ------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
ehthumbs.db

# -------- Editor / IDE --------------------------------------------------
.vscode/
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.iml
*.sublime-workspace
*.sublime-project
.vs/
*.swp
*.swo
*~
# JetBrains shelved changes
.idea/shelf/

# -------- Python cruft (for any vendored helper scripts) ---------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
pip-wheel-metadata/

# -------- Logs / runtime / crash -----------------------------------------
*.log
*.log.*
*.pid
*.pid.lock
*.seed
*.lock-wscript
*.dmp
*.hprof
crash-*.log
hs_err_pid*.log

# -------- Reference & private workspaces ------------------------------
# User-maintained private references that must never ship.
/better-options/
# Reference source trees (several GB) grouped by technology — kept
# locally for research and porting only.
/sources/
# Legacy tools/vendor/ tree. Keep ignored so a stray clone there
# never sneaks back in.
/tools/vendor/
# Prior ad-hoc dumps / scratchpads that have sat at the repo root.
/all/
/analysis/
/cheat/
/lua/
/main/
/phonon/

# -------- Server runtime scratch ---------------------------------------
/.export/
/.agent-mesh/
/.audit/
/.ghidra-projects/
/.fakepdb-scripts/
/.docker-data/
/.index-cache/
/.cache/
/.export-chunks/

# -------- Agent-side state ---------------------------------------------
# Agent session data written next to the project (Claude Code,
# Cursor, Codex).
.claude/
.cursor/
.codex/
.windsurf/
.gemini/

# -------- Catalog source trees ----------------------------------------
# The whole content library lives in db/skills.db. These directories
# are the pre-DB source of truth; scripts/build-db.mjs reads them when
# regenerating the DB. They are NOT shipped in the repo.
/skills/
/plugins/
/agents/
/subagents/
/prompts/

# -------- SQLite side-cars ---------------------------------------------
db/*.db-wal
db/*.db-shm
db/*.db-journal
# The fat DB (with source blobs embedded) and its release-asset
# chunks + checksum are hosted on GitHub Releases, not git.
db/skills-full.db
db/skills-full.db.part-*
db/skills-full.db.sha256

# -------- Build / release artifacts the user may produce locally ------
decompile-*.tar.gz
decompile-*.tar.gz.sha256
decompile-*.zip
decompile-*.zip.sha256
/stage/
/flat/
/release-assets/

# -------- Misc ----------------------------------------------------------
tmp/
.tmp/
*.orig
*.rej
# Generated SBOMs / provenance attestations.
*.sbom.json
*.spdx.json
*.cyclonedx.json
